# GPlay Downloader - Render Environment Configuration

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=info

# Protocol buffers implementation (do not change)
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Disable app pages if not needed (reduce startup time)
DISABLE_APP_PAGES=0

# CORS origins (comma-separated list of allowed origins, empty = disabled)
CORS_ORIGINS=

# Site URL for analytics and links (optional)
SITE_URL=

# Umami analytics script URL (optional)
UMAMI_SCRIPT=

# Umami replay script URL (optional)
UMAMI_REPLAY_SCRIPT=

# APKEditor SHA256 checksum for integrity verification (optional)
APKEDITOR_SHA256=
